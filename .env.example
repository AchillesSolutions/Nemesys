# Which model provider the agents use: offline | azure
KICKOFF_LLM=offline

# Microsoft Foundry (fill in from the Foundry portal once a model is deployed)
# KICKOFF_LLM=azure
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# KICKOFF_MODEL=<deployment name>                  # Teacher, Storyteller, League guide: fast and inexpensive
# KICKOFF_MODEL_PRODUCER=<flagship deployment>      # Producer: weighs every proposal, writes the final words
# KICKOFF_MODEL_HOST=<flagship deployment>          # Host: answers the viewer and calls tools
# KICKOFF_REASONING_EFFORT=low                      # for reasoning models (GPT-5, o-series)

# Azure AI Speech for spoken commentary (optional: without it the browser's own voices are used).
# A Foundry resource includes Speech: set its region, and its key is reused unless AZURE_SPEECH_KEY is set.
# AZURE_SPEECH_REGION=<e.g. swedencentral>
# AZURE_SPEECH_KEY=

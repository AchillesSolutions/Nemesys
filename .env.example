# Copy to .env and fill in. Everything runs on one Microsoft Foundry (AI Services) resource: its key also serves
# Azure AI Speech, Azure AI Translator and Azure AI Content Safety unless a separate key is set below.

# The agents' models: azure (Microsoft Foundry) | offline (no network: template answers, for tests)
KICKOFF_LLM=azure
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=

# Each agent has its own model, chosen by evaluation (see evals/README.md). Override any with KICKOFF_MODEL_<ROLE>:
# KICKOFF_MODEL_NEWS=gpt-5.5
# KICKOFF_MODEL_MATCH=gpt-5.5
# KICKOFF_MODEL_AMMO=gpt-5.4-mini
# KICKOFF_MODEL_MEMORY=gpt-5.4-nano
# KICKOFF_MODEL_REFEREE=gpt-5.4-mini
# KICKOFF_MODEL_KEEPER=Phi-4
# KICKOFF_REASONING_EFFORT=low          # for reasoning models (GPT-5 family)

# The rival's voice: GPT-Live, full duplex, over WebRTC
# KICKOFF_RIVAL_MODEL=gpt-live-1
# KICKOFF_RIVAL_VOICE=                  # override every rival's own voice, for trying voices out
# KICKOFF_RIVAL_ACCENT=

# Azure AI Speech: the lobby host's multilingual voice, and speech recognition in the lobby
AZURE_SPEECH_REGION=swedencentral
# AZURE_SPEECH_KEY=                     # defaults to the Foundry key
# KICKOFF_VOICE_HOST=en-GB-AdaMultilingualNeural

# Azure AI Translator (English captions for Mandarin and Spanish) and Azure AI Content Safety (the Referee's gate)
# AZURE_TRANSLATOR_REGION=swedencentral
# AZURE_TRANSLATOR_KEY=                 # defaults to the Foundry key
# AZURE_CONTENT_SAFETY_ENDPOINT=        # defaults to the Foundry resource's own
# AZURE_CONTENT_SAFETY_KEY=             # defaults to the Foundry key

# Where finished sessions are kept (for memory across matches)
# KICKOFF_RIVAL_SAVES=var/rival

# Spending guards for a public deployment (GPT-Live is billed by the second). 0 or unset: no limit.
# KICKOFF_MAX_VOICES=2                  # rivals talking at once
# KICKOFF_DAILY_VOICE_MINUTES=90        # minutes of voice per day; a reconnect mid-match is always allowed
